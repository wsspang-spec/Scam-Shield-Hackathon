# Copy to .env and fill in. Never commit .env.

# Public base URL of this server (ngrok). No trailing slash.
PUBLIC_HOST=abc123.ngrok-free.app

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+1XXXXXXXXXX        # the protected number scammers call
USER_PHONE=+1XXXXXXXXXX           # your real cell, gets bridged in

# ElevenLabs (Scribe v2 Realtime STT, TTS for warning clip, scammer agent)
ELEVENLABS_API_KEY=
# pcm_8000 (we convert Twilio mu-law to PCM16) or ulaw_8000 (send raw). Verify param name in docs.
SCRIBE_AUDIO_FORMAT=pcm_8000

# Nicrron (OpenAI-compatible). All model calls go through here.
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_API_KEY=
LLM_MODEL=nicrron/fastest   # or anthropic/claude-sonnet-5 for better scoring, slower

# PRISM by Block Convey. Leave endpoint blank to log traces to logs/traces.jsonl only.
PRISM_ENDPOINT=
PRISM_API_KEY=
PRISM_PROJECT=scam-shield

# Detector behavior
FRAUD_THRESHOLD=55
UNCERTAIN_THRESHOLD=20
WINDOW_TURNS=8
HYSTERESIS_WINDOWS=2
KICK_CALLER_AFTER_SECONDS=5
AUTO_KICK=true
